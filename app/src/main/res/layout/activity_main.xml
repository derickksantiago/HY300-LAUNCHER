<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F171E"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm"
            android:format12Hour="hh:mm a"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="RAM Livre: -- MB"
            android:textColor="#8A9BA8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnAtualizarRam"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:text="Atualizar RAM"
            android:textColor="#00E5FF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/card_focus_selector"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:text="Configurações / Keystone"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <GridView
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:horizontalSpacing="18dp"
        android:numColumns="5"
        android:stretchMode="columnWidth"
        android:verticalSpacing="18dp"
        android:focusable="true"
        android:descendantFocusability="afterDescendants" />

</LinearLayout>